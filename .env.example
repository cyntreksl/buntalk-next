# Copy to .env.local for local development:  cp .env.example .env.local
# Staging and production values are set in the hosting/CI environment, never committed.

# ---- Public (exposed to the browser; must start with NEXT_PUBLIC_) ----
# One of: local | staging | production
NEXT_PUBLIC_APP_ENV=local
# Canonical site URL, used for metadata, sitemaps and absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
# ERP backend the storefront reads products, prices, stock and orders from
# (see docs/erp-api-contract.md). All three of base URL, key and tenant are
# needed; locally, leave ERP_API_KEY empty to use the built-in sample catalog.
ERP_API_BASE_URL=https://erp.example.com/api
# Storefront credential issued by the ERP (never a staff user's token).
ERP_API_KEY=
# The Buntalk business (tenant) ID in the ERP.
ERP_TENANT=
# Optional: per-request time limit in milliseconds (default 8000).
ERP_TIMEOUT_MS=
# Shared secret the ERP sends to POST /api/revalidate (at least 16 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# ---- Storefront database (orders and the ERP submission queue, BUN-164) ----
# PostgreSQL connection string. Required on staging and production.
# Locally you can leave it empty: an embedded PGlite database is created in
# PGLITE_DIR (default node_modules/.cache/buntalk/pglite). Apply migrations with:  npm run db:migrate
DATABASE_URL=
PGLITE_DIR=
# Secret for POST /api/orders/retry (run every minute by a scheduler) and
# GET /api/orders/failed (at least 16 characters).
ORDERS_OPS_SECRET=
# Optional: Slack/Teams incoming webhook for order alerts (rejected orders,
# ERP down, retries given up). Alerts are always written to the server log.
ALERT_WEBHOOK_URL=
# Secret the ERP uses to sign order status webhooks (HMAC-SHA256), at least
# 16 characters. Shared with the ERP team; see docs/erp-api-contract.md.
ERP_WEBHOOK_SECRET=
